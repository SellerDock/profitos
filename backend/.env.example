# Tryb hosted jest przeznaczony wyłącznie dla usługi profitos.pl.
DEPLOYMENT_MODE=selfhosted

DATABASE_URL=postgresql+psycopg2://apos_user:change-me-local-db-password@apos-db/apos_db
SECRET_KEY=change-me-long-random-secret
API_BEARER_TOKEN=change-me-long-random-token
# Włącza odszyfrowywanie kosztów skarbca przez serwer dla integracji.
# VAULT_SERVER_DECRYPTION_ENABLED=false
BACKEND_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
ALLEGRO_REDIRECT_URI=http://localhost:8001/api/v1/allegro/callback
ALLEGRO_CLIENT_ID=your-profitos-allegro-client-id
ALLEGRO_CLIENT_SECRET=your-profitos-allegro-client-secret
ALLEGRO_SCOPES=allegro:api:profile:read allegro:api:orders:read allegro:api:sale:offers:read allegro:api:billing:read allegro:api:payments:read
APP_BASE_URL=http://localhost:3001
IFIRMA_USERNAME=your-ifirma-login
IFIRMA_INVOICE_KEY=your-ifirma-faktura-api-key
IFIRMA_SUBSCRIBER_KEY=your-ifirma-abonent-api-key
IFIRMA_INVOICE_KEY_NAME=faktura

# Opcjonalny nagłówek User-Agent dla Allegro; domyślnie zawiera APP_BASE_URL.
# ALLEGRO_USER_AGENT=ProfitOS/0.1.0 (+https://example.com)

# Opcjonalny branding i analityka publicznej aplikacji.
# BRAND_PRODUCT_NAME=ProfitOS
# W trybie hosted na profitos.pl: BRAND_PRODUCT_NAME=ProfitOS.pl
# BRAND_SUPPORT_EMAIL=kontakt@example.com
# PUBLIC_SITE_URL=https://www.example.com
# PUBLIC_APP_URL=https://app.example.com
# ANALYTICS_GA_ID=G-XXXXXXXXXX
# ANALYTICS_AHREFS_KEY=twoj_klucz
