# Domena wskazująca na serwer, bez protokołu.
PROFITOS_DOMAIN=twoja-domena.example
# Użytkownik bazy danych PostgreSQL.
POSTGRES_USER=profitos
# Hasło bazy: ustaw własne, bez znaków wymagających kodowania w URL.
POSTGRES_PASSWORD=
# Nazwa bazy danych PostgreSQL.
POSTGRES_DB=profitos
# Adres bazy składany z powyższych wartości; znaki specjalne w URL wymagają kodowania.
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@apos-db/${POSTGRES_DB}
# Sekret aplikacji: wygeneruj za pomocą openssl rand -hex 32.
SECRET_KEY=
# Publiczny adres aplikacji.
APP_BASE_URL=https://${PROFITOS_DOMAIN}
# Dozwolone źródła CORS, oddzielone przecinkami.
BACKEND_CORS_ORIGINS=https://${PROFITOS_DOMAIN}
# Identyfikator aplikacji z portalu Allegro.
ALLEGRO_CLIENT_ID=
# Sekret aplikacji z portalu Allegro.
ALLEGRO_CLIENT_SECRET=
# Adres przekierowania skonfigurowany również w aplikacji Allegro.
ALLEGRO_REDIRECT_URI=https://${PROFITOS_DOMAIN}/api/v1/accounts/allegro/callback
# Tryb samodzielnej instalacji.
DEPLOYMENT_MODE=selfhosted
# Środowisko produkcyjne.
APP_ENV=production
# Przesyłaj ciasteczko sesji wyłącznie przez HTTPS.
AUTH_COOKIE_SECURE=true

# Opcjonalny serwer SMTP do wysyłania wiadomości.
# SMTP_HOST=
# Port serwera SMTP.
# SMTP_PORT=587
# Nazwa użytkownika SMTP.
# SMTP_USERNAME=
# Hasło użytkownika SMTP.
# SMTP_PASSWORD=
# Adres nadawcy wiadomości.
# SMTP_FROM_EMAIL=
# Nazwa nadawcy wiadomości.
# SMTP_FROM_NAME=ProfitOS
# Czy używać STARTTLS.
# SMTP_STARTTLS=true
